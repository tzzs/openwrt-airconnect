#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 tzzs
#
# procd supervision for the upstream AirConnect engines.
#
# This script only reads UCI: validation, normalization and the generated
# runtime XML belong to the ucode core in runtime.uc, which is the only writer
# of /var/etc/airconnect-manager/. Nothing here ever writes to
# /etc/config/airconnect-manager.
#
# Publishing contract: rc.common runs start_service inside procd_open_service/
# procd_close_service, and whatever instances start_service registers become the
# complete instance set. Procd stops every instance missing from that set, so an
# instance list is only ever published after every fatal condition has been
# ruled out. A rejected configuration must leave engines that still run on the
# last valid XML alone, which is why the failure paths exit before publishing
# instead of returning early.

USE_PROCD=1
START=95
STOP=10

CONFIG_NAME='airconnect-manager'
DEFAULT_INTERFACE='br-lan'

# Host-side tests need a sandbox instead of the real /var and /usr. The prefix is
# empty on the router, so the defaults below are the real paths; it is only
# honoured as an absolute path to an existing directory. Same idea as
# IPKG_INSTROOT in rc.common.
ROOT=''
case "${AIRCONNECT_MANAGER_ROOT:-}" in
	/*) [ -d "${AIRCONNECT_MANAGER_ROOT}" ] && ROOT="${AIRCONNECT_MANAGER_ROOT}" ;;
esac

RUNTIME_DIR="${ROOT}/var/etc/airconnect-manager"
RUNTIME_APPLY="${ROOT}/usr/share/airconnect-manager/runtime.uc"
ENGINE_DIR="${ROOT}/usr/libexec/airconnect"
PID_DIR="${ROOT}/var/run"

ENABLED=0
AIRUPNP=0
AIRCAST=0
INTERFACE="${DEFAULT_INTERFACE}"

log_warn() {
	logger -t airconnect-manager -p daemon.warn "$1"
}

log_err() {
	logger -t airconnect-manager -p daemon.err "$1"
}

# The interface only reaches the engine as <binding> inside the generated XML,
# never as an argument of this script, but refuse anything that is not a bare
# Linux interface token anyway so a corrupt value can never be mistaken for a
# path or an option. runtime.uc performs the authoritative validation, so this
# allowlist is that one: first character [A-Za-z0-9_], the rest [A-Za-z0-9_.-],
# 1..15 bytes, and neither '.' nor '..'. A value that shell accepts and the
# backend rejects would only produce a misleading warning here and a rejected
# configuration there.
valid_interface() {
	case "$1" in
		''|.|..) return 1 ;;
	esac
	case "$1" in
		[!A-Za-z0-9_]*) return 1 ;;
	esac
	case "$1" in
		*[!A-Za-z0-9_.-]*) return 1 ;;
	esac
	[ "${#1}" -le 15 ]
}

load_config() {
	config_load "${CONFIG_NAME}"
	config_get_bool ENABLED main enabled 0
	config_get_bool AIRUPNP main airupnp 0
	config_get_bool AIRCAST main aircast 0
	config_get INTERFACE main interface "${DEFAULT_INTERFACE}"
	if ! valid_interface "${INTERFACE}"; then
		log_warn "configured interface is not a bare interface name, using ${DEFAULT_INTERFACE}"
		INTERFACE="${DEFAULT_INTERFACE}"
	fi
}

# Everything that can stop the service from running is checked here, before
# procd is told about any instance. A nonzero return means "publish nothing".
prepare_runtime() {
	if [ ! -x "${RUNTIME_APPLY}" ]; then
		log_err "cannot generate engine configuration: ${RUNTIME_APPLY} is missing or not executable"
		return 1
	fi
	if ! mkdir -p "${RUNTIME_DIR}"; then
		log_err "cannot create ${RUNTIME_DIR}"
		return 1
	fi
	chmod 0750 "${RUNTIME_DIR}" 2>/dev/null

	# runtime.uc keeps the previous valid XML when validation or rendering
	# fails, so this return does not lose the configuration in use.
	if ! "${RUNTIME_APPLY}" apply; then
		log_err 'runtime configuration was rejected, keeping the previous generated files'
		return 1
	fi
	return 0
}

engine_ready() {
	[ -x "${ENGINE_DIR}/$1" ] || {
		log_err "engine $1 is not installed at ${ENGINE_DIR}/$1"
		return 1
	}
	# No usable XML means no configuration: never start an engine blind.
	[ -s "${RUNTIME_DIR}/$1.xml" ] || {
		log_err "no usable $1.xml, refusing to start $1 without configuration"
		return 1
	}
	return 0
}

start_engine() {
	local engine="$1"
	local xml="${RUNTIME_DIR}/${engine}.xml"

	# -Z keeps the engine in the foreground so procd owns respawn and logging;
	# upstream would otherwise daemonize behind procd's back. Never pass -z.
	procd_open_instance "${engine}"
	procd_set_param command "${ENGINE_DIR}/${engine}" -Z -x "${xml}"
	procd_set_param respawn 3600 5 5
	procd_set_param file "${xml}"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile "${PID_DIR}/airconnect-${engine}.pid"
	procd_close_instance
}

start_service() {
	load_config

	if [ "${ENABLED}" != 1 ]; then
		# Disabled by the user. Publishing no instance stops a previously
		# started engine, which is exactly what disabling must do. Nothing
		# alarming is logged: this is the documented default after install.
		return 0
	fi
	if [ "${AIRUPNP}" != 1 ] && [ "${AIRCAST}" != 1 ]; then
		log_warn 'service is enabled but no engine is selected, nothing to start'
		return 0
	fi

	# Everything below this point can still refuse to start, so every check
	# finishes before the first procd_open_instance: exiting now leaves any
	# running instance registered and its last valid XML untouched.
	if ! prepare_runtime; then
		exit 1
	fi
	if [ "${AIRUPNP}" = 1 ] && ! engine_ready airupnp; then
		exit 1
	fi
	if [ "${AIRCAST}" = 1 ] && ! engine_ready aircast; then
		exit 1
	fi

	if [ ! -e "/sys/class/net/${INTERFACE}" ]; then
		log_warn "interface ${INTERFACE} is not present, the engine may fail to bind"
	fi

	[ "${AIRUPNP}" = 1 ] && start_engine airupnp
	[ "${AIRCAST}" = 1 ] && start_engine aircast
	return 0
}

stop_service() {
	# procd terminates the instances that start_service registered.
	return 0
}

reload_service() {
	# rc.common does not wrap reload in procd_open_service, so the instance set
	# has to be published here. Unchanged instances keep running: procd restarts
	# only the ones whose command, parameters or tracked file changed.
	rc_procd start_service "$@"
}

service_triggers() {
	procd_add_reload_trigger "${CONFIG_NAME}"
}
