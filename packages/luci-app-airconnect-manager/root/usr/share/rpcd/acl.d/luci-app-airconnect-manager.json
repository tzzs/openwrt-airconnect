{
  "luci-app-airconnect-manager": {
    "description": "Manage AirConnect devices and settings",
    "read": {
      "ubus": {
        "airconnect.manager": ["status", "logs"],
        "network.interface": ["dump"]
      },
      "uci": ["airconnect-manager"]
    },
    "write": {
      "ubus": { "airconnect.manager": ["scan", "validate", "action"] },
      "uci": ["airconnect-manager"]
    }
  }
}
