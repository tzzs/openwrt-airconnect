msgid "No scan has been completed."
msgstr "尚未完成扫描。"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:403
msgid "Interface"
msgstr "接口"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:404
msgid "Manager version"
msgstr "管理器版本"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:405
msgid "AirPlay broadcast (UPnP)"
msgstr "AirPlay 广播（UPnP）"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:406
msgid "AirPlay broadcast (Chromecast)"
msgstr "AirPlay 广播（Chromecast）"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:407
msgid "Playback"
msgstr "播放"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:418
msgid "Status unavailable. Displayed information may be stale. "
msgstr "状态不可用。显示的信息可能已过期。"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:425
msgid "Could not start discovery."
msgstr "无法开始发现。"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:426
msgid "Discovery requested. Results will update automatically."
msgstr "已请求发现。结果会自动更新。"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:434
msgid "No unsaved changes"
msgstr "没有未保存的更改"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:442
msgid "Find your speakers"
msgstr "查找你的音箱"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:442
msgid ""
"Turn on a discovery engine in Settings, then scan. Keep your speaker online "
"on the same LAN and enable DLNA when required."
msgstr "先在“设置”中启用发现引擎，再进行扫描。请保持音箱在线并与路由器处于同一局域网；必要时启用 DLNA。"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:446
#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:474
