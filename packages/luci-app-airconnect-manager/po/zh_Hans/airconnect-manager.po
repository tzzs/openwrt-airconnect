msgstr "已禁用"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:366
msgid "Running"
msgstr "运行中"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:366
msgid "Stopped"
msgstr "已停止"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:366
msgid "Unknown"
msgstr "未知"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:369
msgid "Service running does not confirm AirPlay availability or playback."
msgstr "服务运行不代表 AirPlay 可用或正在播放。"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:372
msgid "Another AirConnect instance was detected."
msgstr "检测到另一个 AirConnect 实例。"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:372
msgid "Stop the existing instance before starting these engines."
msgstr "启动这些引擎前请先停止现有实例。"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:395
msgid "Scanning…"
msgstr "扫描中…"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:395
#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:440
msgid "Scan for speakers"
msgstr "扫描音箱"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:396
msgid "Scan failed: "
msgstr "扫描失败："

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:396
msgid "Discovery is in progress."
msgstr "正在发现设备。"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:396
