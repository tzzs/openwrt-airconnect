#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:322
#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:324
#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:337
#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:339
msgid "observed"
msgstr "已观测"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:324
msgid "No"
msgstr "否"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:325
msgid "Unknown — not measured"
msgstr "未知 — 尚未测量"

#: packages/luci-app-airconnect-manager/htdocs/luci-static/resources/view/airconnect-manager/overview.js:337
