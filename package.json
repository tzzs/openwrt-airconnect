{
  "name": "openwrt-airconnect",
  "version": "0.1.0",
  "private": true,
  "description": "Independent OpenWrt / iStoreOS adapter for philippe44/AirConnect",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tzzs/openwrt-airconnect.git"
  },
  "type": "module",
  "scripts": {
    "test": "bash scripts/run-tests.sh",
    "coverage": "bash scripts/run-coverage.sh",
    "lint:js": "eslint .",
    "lint:shell": "node scripts/check-shell.mjs lint",
    "lint": "npm run lint:js && npm run lint:shell",
    "format": "prettier --write . --ignore-unknown && node scripts/check-shell.mjs format",
    "format:check": "prettier --check . --ignore-unknown && node scripts/check-shell.mjs format:check"
  },
  "//": "Root npm dependencies provide development-only lint and formatting tools. The router runtime has no npm dependencies or Node build step.",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10"
  }
}
